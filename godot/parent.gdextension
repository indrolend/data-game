[configuration]
entry_symbol = "parent_library_init"
compatibility_minimum = "4.3"
[libraries]
windows.debug.x86_64 = "res://bin/digital_breakdown_parent.dll"
windows.release.x86_64 = "res://bin/digital_breakdown_parent.dll"
linux.debug.x86_64 = "res://bin/digital_breakdown_parent.so"
linux.release.x86_64 = "res://bin/digital_breakdown_parent.so"
macos.debug = "res://bin/digital_breakdown_parent.dylib"
macos.release = "res://bin/digital_breakdown_parent.dylib"
